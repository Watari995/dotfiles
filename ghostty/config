term = xterm-256color
auto-update = off

macos-non-native-fullscreen = true
macos-option-as-alt = left

mouse-hide-while-typing = false
scroll-to-bottom = no-keystroke, no-output
copy-on-select = true
confirm-close-surface = false
link-url = true

# Font
font-family = JetBrains Mono
font-family = Symbols Nerd Font Mono
font-family = UDEV Gothic
font-family-bold = JetBrains Mono Bold
font-family-italic = JetBrains Mono Italic
font-family-bold-italic = JetBrains Mono Bold Italic
font-size = 14
# Slightly increase line spacing for readability.
adjust-cell-height = 7%
adjust-cursor-thickness = 175%

# Window
background-opacity = 0.75
background-blur = 20
unfocused-split-opacity = 1
split-preserve-zoom = true
window-padding-x = 12
window-padding-y = 0
window-colorspace = display-p3
window-decoration = none

# Keyboard
keybind = shift+escape=unbind
keybind = cmd+j=toggle_split_zoom
keybind = cmd+right=esc:[F
keybind = cmd+left=esc:[H
keybind = super+f=toggle_fullscreen
keybind = cmd+shift+o=toggle_background_opacity
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Quick Terminal
quick-terminal-position = right
quick-terminal-animation-duration = 0.1
quick-terminal-autohide = true

# Enter Herdr scroll/copy mode
keybind = alt+n=text:\x01[
keybind = alt+h=scroll_page_down
keybind = alt+l=scroll_page_up
keybind = alt+j=scroll_page_lines:2
keybind = alt+k=scroll_page_lines:-2

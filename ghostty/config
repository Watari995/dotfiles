term = xterm-256color
auto-update = off

macos-non-native-fullscreen = true
macos-option-as-alt = left

mouse-hide-while-typing = false
scroll-to-bottom = no-keystroke, no-output
copy-on-select = true
confirm-close-surface = false
link-url = true

# Font
# Current: ASCII/code uses Berkeley Mono, Nerd Font icons use Symbols,
# Japanese uses UDEV Gothic.
#
# Berkeley Mono is installed manually in ~/Library/Fonts because it is a paid font.
font-family = Berkeley Mono
font-family = Symbols Nerd Font Mono
font-family = UDEV Gothic
font-family-bold = Berkeley Mono Bold
font-family-italic = Berkeley Mono Oblique
font-family-bold-italic = Berkeley Mono Bold Oblique
font-size = 14
adjust-cursor-thickness = 175%
cursor-color = #66cc66
cursor-text = #171717

# Window
background-opacity = 1
# background-opacity = 0.9
unfocused-split-opacity = 1
window-padding-x = 12
window-padding-y = 0
window-colorspace = display-p3
macos-titlebar-style = tabs

# Theme
theme = TokyoNight Night

# Keyboard
keybind = shift+escape=unbind
keybind = cmd+j=toggle_split_zoom
keybind = cmd+right=esc:[F
keybind = cmd+left=esc:[H
keybind = super+f=toggle_fullscreen
keybind = alt+h=scroll_page_down
keybind = alt+l=scroll_page_up
keybind = alt+j=scroll_page_lines:1
keybind = alt+k=scroll_page_lines:-1
